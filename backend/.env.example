# PostgreSQL datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resume_builder
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# Hibernate/JPA
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Spring/Server runtime
SPRING_MAIN_ALLOW_CIRCULAR_REFERENCES=true
SERVER_TOMCAT_MAX_HTTP_FORM_POST_SIZE=0
SERVER_TOMCAT_CONNECTION_TIMEOUT=30s
SPRING_CODEC_MAX_IN_MEMORY_SIZE=10MB

# JWT
APP_JWT_SECRET=replace_with_a_32_plus_character_secret
APP_JWT_EXPIRATION_MS=3600000

# CORS (comma-separated origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

